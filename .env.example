# Variables para docker compose (mysql, redis, api, worker).
# Copiar a ".env" en la raiz del repo y completar los valores.

# --- mysql ---
MYSQL_ROOT_PASSWORD=change-me-root-password
MYSQL_DATABASE=instantmovies
MYSQL_USER=instantmovies
MYSQL_PASSWORD=change-me-app-password

# --- backend (api + worker) ---
# el host es "mysql", el nombre del servicio en docker-compose.yml, no localhost.
# usuario/password deben coincidir con MYSQL_USER/MYSQL_PASSWORD de arriba.
DATABASE_URL=mysql://instantmovies:change-me-app-password@mysql:3306/instantmovies
# el host es "redis", el nombre del servicio, no localhost.
REDIS_URL=redis://redis:6379

PORT=3000
# origen exacto del frontend: cors lo usa con credentials:true (cookie httpOnly de auth)
FRONTEND_URL=http://localhost:5173

# min 32 characters
JWT_SECRET=96b3e4ee293bf6c89be1b0f8c779eaa07e2230a24975b66e1b259978b3d42c5e
TMDB_API_KEY=change-me-tmdb-api-key
GROQ_API_KEY=change-me-groq-api-key
# helicone: proxy de observabilidad; los requests a groq pasan por groq.helicone.ai y quedan logueados.
# se obtiene en https://www.helicone.ai -> Settings -> API Keys -> Generate New Key (empieza con "sk-helicone-").
# opcional: si no se provee, los requests van directo a api.groq.com.
HELICONE_API_KEY=
